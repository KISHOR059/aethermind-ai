PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development
CRON_SECRET=replace-with-a-secure-random-cron-secret

# AI Provider Selection ("groq" or "gemini")
AI_PROVIDER=groq

# ==========================================
# Groq 3-Key Pool configuration (Ultra-fast inference ~200ms)
# ==========================================
GROQ_API_KEY=
GROQ_API_KEY_FALLBACK_1=
GROQ_API_KEY_FALLBACK_2=
GROQ_MODEL=qwen/qwen3.8-27b
AI_GROQ_TIMEOUT_MS=30000

# ==========================================
# Gemini backup configuration
# ==========================================
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACK_1=
GEMINI_API_KEY_FALLBACK_2=
GEMINI_API_KEY_FALLBACK_3=
GEMINI_MODEL=gemini-3.8-flash
AI_THINKING_LEVEL=medium
AI_GEMINI_TIMEOUT_MS=30000

# Database & Auth
MONGODB_URI=mongodb://127.0.0.1:27017/aethermind
JWT_ACCESS_SECRET=replace-with-a-long-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-long-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
SESSION_INACTIVITY_TIMEOUT_MS=86400000
SESSION_MAX_LIFETIME_MS=604800000
SESSION_WARNING_MS=300000